# Azure (Terraform usa tu sesión de `az login`; la v4 de azurerm exige esta variable)
ARM_SUBSCRIPTION_ID=Tu_ID_Subscription_azure

# Modelo de IA en Azure AI Foundry (lo usa llm.py)
AZURE_AI_ENDPOINT=Tu_Endpoint_azure_AI
AZURE_AI_DEPLOYMENT=gpt-6-luna
AZURE_AI_API_KEY=Tu_Azure_AI_Api_Key

# Opcional: regiones alternas en orden, separadas por comas.
# Si la dejas vacía o la quitas, usa: eastus2,brazilsouth,swedencentral,centralus,westus2,westus3,southcentralus
AZURE_FALLBACK_REGIONS=brazilsouth,swedencentral,eastus2